{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "~shared/*": ["./src/shared/*"],
      "~assets/*": ["./src/assets/*"]
    }
  },
  "include": ["src/**/*", "*.ts", "*.mts", "config/**/*"]
}
